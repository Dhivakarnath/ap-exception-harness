# Copy to .env and fill in. Startup FAILS LOUDLY on missing required values
# rather than falling back to a silent default (requirements NFR-8, FR-8.4).

# ----------------------------------------------------------------- runtime
ENV=local
LOG_LEVEL=INFO

# ---------------------------------------------------------------- database
# REQUIRED. pgvector extension is required (ADR-008).
DATABASE_URL=postgresql+psycopg://ap:ap@localhost:5432/ap_agent

# ----------------------------------------------------------------- bedrock
# Credentials come from the standard AWS chain (profile, env, or role) —
# never committed here.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --------------------------------------------------------------- retrieval
# embedding_provider: bedrock | local
#   bedrock -> Titan Text Embeddings V2
#   local   -> sentence-transformers on CPU (no API cost, fully self-contained)
EMBEDDING_PROVIDER=bedrock
EMBEDDING_DIMENSIONS=1024
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=4
CODING_RETRIEVAL_TOP_K=2

# ------------------------------------------------------- external services
MOCK_ERP_BASE_URL=http://localhost:8091

# ----------------------------------------------------------- observability
# Leave Langfuse blank to run without it. Partial config is rejected —
# a half-configured dashboard is a silent blind spot (FR-12.4).
OTEL_SERVICE_NAME=ap-exception-agent
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#
# Langfuse (self-hosted). Start with `make obs-up`. Docker-compose bootstraps
# a project and user — set ALL keys below together or leave all blank.
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PROJECT_ID=
# LANGFUSE_DEMO_EMAIL=
# LANGFUSE_DEMO_PASSWORD=

# Real document runs are evaluated asynchronously with DeepEval + Bedrock.
# Disable only when judge cost/latency is intentionally not desired.
LIVE_EVALS_ENABLED=true

# ------------------------------------------------------------- run budgets
# Safety controls against runaway loops (NFR-4). Not fallbacks.
MAX_MODEL_CALLS_PER_RUN=25
MAX_TOOL_CALLS_PER_RUN=40
MAX_TOKENS_PER_RUN=120000
MAX_RUN_SECONDS=180

# ---------------------------------------------- retry (TRANSIENT I/O ONLY)
TRANSIENT_RETRY_ATTEMPTS=3
TRANSIENT_RETRY_INITIAL_DELAY=1.0
TRANSIENT_RETRY_BACKOFF_FACTOR=2.0

# ---------------------------------------------------- HITL checkpointing
# postgres = durable pause/resume across API restarts (production)
# in_memory = fast, single-process only (local demos)
CHECKPOINTER_BACKEND=postgres
CHECKPOINT_TTL_DAYS=30
REVIEW_EXPIRY_DAYS=14

# ----------------------------------------------------------------- tenancy
DEFAULT_TENANT=manufacturing-demo

# ----------------------------------------------------------- notifications
# console | slack | email
# 'slack' requires both token and channel or startup fails: an undeliverable
# HITL escalation is unacceptable (FR-11.3).
NOTIFY_CHANNEL=console
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL=#ap-approvals
