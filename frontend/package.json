{
  "name": "ap-exception-agent-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Transparency UI for the agentic AP exception-handling system.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
